  "interview": {
    "id": "1914-04-interview-direktor",
    "typ": "interview",
    "art": "einordnung",
    "date": "1914-04",
    "rubrik": "Im Gespräch mit dem Direktor",
    "titel": "„Volle Läden, Arbeit in anderen Städten – und Stolz auf das Geschaffene“",
    "teaser": "Der Direktor der Société des Routes et des Rails über die Möbelverbindung nach Sin-le-Noble, die Grenzen der Schifffahrt und einen Fortschritt, den sich die Gesellschaft leisten können muss. Ein Interview mit dem Spieler; Antworten sprachlich redigiert.",
    "partner": {
      "name": "Der Direktor",
      "rolle": "Leiter der Société des Routes et des Rails · Antworten des Spielers"
    },
    "fragen": [
      {
        "frage": "Monsieur le Directeur, weshalb haben Sie gerade Sin-le-Noble für die Möbelversorgung ins Auge gefasst?",
